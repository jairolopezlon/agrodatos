{
  "name": "@agrodatos/worker-etl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "coverage": "node --experimental-strip-types scripts/validate-coverage.ts",
    "coverage:strict": "node --experimental-strip-types scripts/validate-coverage.ts --strict",
    "coverage:update": "node --experimental-strip-types scripts/validate-coverage.ts --update"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@agrodatos/shared-types": "workspace:*",
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
